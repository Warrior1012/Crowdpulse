PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_ID=demo-session
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-admin-password
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=replace-this-operator-password
SENSOR_USERNAME=sensor
SENSOR_PASSWORD=replace-this-sensor-password
ATTENDEE_USERNAME=attendee
ATTENDEE_PASSWORD=replace-this-attendee-password
ADMIN_KEY=replace-this-admin-key

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=7000
# Keep the Gemini key only in backend/Render environment variables.
SENSOR_INTERVAL_SECONDS=2
# Optional separately deployed Python AI service:
AI_SERVICE_URL=http://127.0.0.1:8000
