PORT=4000
DATABASE_URL=postgresql://crowdpulse:crowdpulse@localhost:5432/crowdpulse
REDIS_URL=rediss://localhost:6379
REDIS_PASSWORD=change-this-redis-password
REDIS_TLS=true
REDIS_TLS_CA=../redis-certs/ca.crt
REDIS_TLS_SERVERNAME=localhost
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_CHANNEL=crowdpulse:events
SESSION_ID=demo-session
JWT_SECRET=replace-this-in-production-with-a-long-random-secret
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=crowdpulse-admin
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=crowdpulse-operator
SENSOR_USERNAME=sensor
SENSOR_PASSWORD=crowdpulse-sensor
ADMIN_KEY=demo-admin-key

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=7000
SENSOR_INTERVAL_SECONDS=2
AI_SERVICE_URL=http://ai-service:8000
